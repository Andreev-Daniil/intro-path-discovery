# --- Внешние источники для intro-paths enrich-target ---
# SEC требует контакт в User-Agent: "Имя Фамилия you@example.com"
SEC_USER_AGENT=
# Необязательно: ключ OpenAlex повышает дневной лимит; mailto — «вежливый» пул
OPENALEX_API_KEY=
OPENALEX_MAILTO=
CROSSREF_MAILTO=

# --- LLM-агент (config/agent.toml читает значения по именам api_key_env / base_url_env) ---
API_KEY=
API_LINK=https://routerai.ru/api/v1

# --- LinkedIn (только scripts/fetch_linkedin.py) ---
# Вариант А: обычный вход (если у LinkedIn-аккаунта есть пароль)
LINKEDIN_USERNAME=your_email@example.com
LINKEDIN_PASSWORD=your_password

# Вариант Б: вход через Google — cookies из браузера (DevTools -> Application -> Cookies -> linkedin.com)
# LINKEDIN_LI_AT=
# LINKEDIN_JSESSIONID=ajax:<значение из cookies>
